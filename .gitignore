**/.vitest-*-fixture-*/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
.envrc

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local AI enhancement settings
.agents/settings.local.json

# Claude Code session runtime
.claude/

# Agent plans (local working documents)
.plans/

*storybook.log

.yarn/*
!.yarn/releases
**/storybook-static/
**/storybook-server/

# Vercel CLI project link + build output (scratch deploys/smoke tests)
.vercel/
_vercel-trace-hints.js
