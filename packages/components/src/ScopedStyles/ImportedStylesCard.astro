---
/** A card styled only by stylesheets it imports: a plain one and a CSS module. */
import './ImportedStylesCard.css';
import styles from './ImportedStylesCard.module.css';

const { label = 'Styled by imported stylesheets' } = Astro.props;

---
<div class="imported-card" data-testid="imported-styles-card">
  <span class={styles.label} data-testid="imported-styles-label">{label}</span>
</div>
