    "@preact/preset-vite": "^2.10.1",
    "@storybook/preact": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/svelte": "^10.0.0",
    "@storybook/vue3": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0 || ^6.0.0",
    "@vitejs/plugin-vue": "^5.2.3 || ^6.0.0",
