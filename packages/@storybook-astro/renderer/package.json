{
  "name": "@storybook-astro/renderer",
  "version": "1.6.0",
  "description": "Client-side renderer for Storybook Astro framework",
  "module": "./dist/preset.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybook-astro/storybook-astro.git",
    "directory": "packages/@storybook-astro/renderer"
  },
  "homepage": "https://storybook-astro.org",
  "bugs": {
    "url": "https://github.com/storybook-astro/storybook-astro/issues"
  },
  "engines": {
    "node": ">=20.16.0 || >=22.19.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./entry-preview": "./dist/entry-preview.js",
    "./preview-defaults": {
      "types": "./dist/preview-defaults.d.ts",
      "import": "./dist/preview-defaults.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "lint": "eslint .",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "astro": "^5.6.1 || ^6.0.0",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "@storybook/react": "^10.0.0",
    "astro": "^5.5.3 || ^6.0.0",
    "storybook": "^10.0.0"
  },
  "dependencies": {
    "@types/node": "^20.19.0"
  },
  "peerDependenciesMeta": {
    "@storybook/react": {
      "optional": true
    }
  }
}
