{
  "name": "storybook-astro-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.16.0 || >=22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -A --parallel --interlaced --include '@storybook-astro/{website,sandbox-astro5,sandbox-astro6}' run dev",
    "website": "yarn workspace @storybook-astro/website dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn vitest run",
    "build:packages": "yarn workspaces foreach -A --include '@storybook-astro/{framework,renderer}' run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-astro": "^1.3.2",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-storybook": "10.2.7",
    "eslint-plugin-svelte": "^3.13.1",
    "eslint-plugin-vue": "^10.1.6",
    "eslint-plugin-workspaces": "^0.10.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "svelte-eslint-parser": "^1.1.8",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.1.3"
  },
  "workspaces": [
    "packages/@storybook-astro/*",
    "packages/components",
    "apps/*"
  ],
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "vitefu": "^1.1.0"
  }
}
