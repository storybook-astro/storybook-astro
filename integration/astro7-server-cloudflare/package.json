    "preact": "^10.28.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook-astro/adapter-cloudflare": "workspace:*",
    "@storybook-astro/framework": "workspace:*",
    "@storybook-astro/integration-server-shared": "workspace:*",
    "eslint": "^9.39.2",
    "storybook": "10.6.0",
    "vite": "^8.0.0",
    "wrangler": "^4.125.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
