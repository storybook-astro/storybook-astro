{
  "name": "@storybook-astro/integration-astro6-server",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "storybook dev -p 6016",
    "build": "storybook-astro build",
    "build:vercel": "STORYBOOK_ADAPTER=vercel storybook-astro build",
    "serve": "HOST=127.0.0.1 PORT=6017 node storybook-server/server/entry.mjs",
    "lint": "eslint .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "10.1.4",
    "@astrojs/preact": "5.0.0",
    "@astrojs/vercel": "10.0.8",
    "@storybook-astro/components": "workspace:*",
    "astro": "6.4.8",
    "msw": "^2.12.10",
    "preact": "^10.28.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook-astro/adapter-node": "workspace:*",
    "@storybook-astro/adapter-vercel": "workspace:*",
    "@storybook-astro/framework": "workspace:*",
    "@storybook/addon-docs": "10.6.0",
    "eslint": "^9.39.2",
    "storybook": "10.6.0",
    "vite": "^7.3.1"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
