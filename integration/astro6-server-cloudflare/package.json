  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook-astro/adapter-cloudflare": "workspace:*",
    "@storybook-astro/framework": "workspace:*",
    "@storybook/addon-docs": "10.6.0",
    "eslint": "^9.39.2",
    "storybook": "10.6.0",
    "vite": "^7.3.1",
    "wrangler": "^4.46.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
