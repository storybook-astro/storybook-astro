    "astro": "5.17.2",
    "msw": "^2.12.10",
    "preact": "^10.28.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook-astro/adapter-node": "workspace:*",
    "@storybook-astro/adapter-vercel": "workspace:*",
    "@storybook-astro/framework": "workspace:*",
    "@storybook/addon-docs": "10.6.0",
    "eslint": "^9.39.2",
    "storybook": "10.6.0",
    "vite": "^6.2.5"
